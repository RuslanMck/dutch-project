DATA_DIR=/srv/data/dutch   # where dutch.db and backups/ live (default ./data)
APP_PASSWORD=change-me
SESSION_SECRET=   # openssl rand -hex 32
API_TOKEN=        # openssl rand -hex 32
MCP_SECRET=       # openssl rand -hex 32
OPENROUTER_API_KEY=   # optional; enables «Згенерувати ще» on the word-order page and new rule exercises
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
RULE_EXERCISE_MODEL=google/gemini-3.7-flash   # model for «Вправи з правил»; cheaper: anthropic/claude-haiku-5.5
