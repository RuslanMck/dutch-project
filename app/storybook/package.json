{
  "name": "dutch-app-storybook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Storybook for the Dutch app's Сад components and tokens.",
  "scripts": {
    "tokens": "node scripts/build-tokens.js",
    "storybook": "npm run tokens && storybook dev -p 6006 --no-open",
    "build": "npm run tokens && storybook build -o storybook-static"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/html": "8.6.14",
    "@storybook/html-vite": "8.6.14",
    "storybook": "8.6.14",
    "vite": "6.3.5"
  }
}
